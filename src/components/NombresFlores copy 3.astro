<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";

    document.addEventListener("DOMContentLoaded", () => {
        console.log("🎊 Iniciando animaciones de boda - TODAS AL MISMO TIEMPO...");

        // ═══ FLORES SUPERIORES ═══
        gsap.fromTo(
            "#flores-sup-izq",
            { opacity: 0, x: -100 },
            { opacity: 1, x: 0, duration: 0.8, ease: "power2.out", delay: 0 }
        );

        gsap.fromTo(
            "#flores-sup-der",
            { opacity: 0, x: 100 },
            { opacity: 1, x: 0, duration: 0.8, ease: "power2.out", delay: 0 }
        );

        // ═══ TÍTULO "NOS CASAMOS" ═══
        gsap.fromTo(
            "#titulo",
            { opacity: 0, y: -40 },
            { opacity: 1, y: 0, duration: 0.8, ease: "power2.out", delay: 0.1 }
        );

        // ═══ ANILLOS ═══
        gsap.fromTo(
            "#anillos",
            { opacity: 0, scale: 0.5 },
            { opacity: 1, scale: 1, duration: 0.8, ease: "back.out(1.4)", delay: 0.2 }
        );

        // Rotación suave continua de los anillos
        gsap.to("#anillos", {
            rotation: 5,
            duration: 3,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
            delay: 1
        });

        // ═══ FUNCIÓN PARA ANIMAR NOMBRES LETRA POR LETRA ═══
        function animarNombre(elementId, texto, delay = 0) {
            const contenedor = document.getElementById(elementId);
            if (!contenedor) return;

            contenedor.innerHTML = texto
                .split("")
                .map(
                    (letra, index) =>
                        `<span class="letra-cascada" style="
                            --i: ${index};
                            opacity: 0; 
                            display: inline-block; 
                            transform: translateY(20px) scale(0.8);
                            filter: blur(2px);
                        ">${letra === " " ? "&nbsp;" : letra}</span>`
                )
                .join("");

            gsap.to(`#${elementId} .letra-cascada`, {
                opacity: 1,
                y: 0,
                scale: 1,
                filter: "blur(0px)",
                duration: 0.6,
                ease: "power2.out",
                stagger: { each: 0.04, from: "start" },
                delay: delay
            });
        }

        // ═══ NOMBRE DEL NOVIO ═══
        animarNombre("nombre-novio", "Jhonny", 0.3);

        // ═══ SÍMBOLO & ═══
        gsap.fromTo(
            "#ampersand",
            { opacity: 0, scale: 0.7 },
            { opacity: 1, scale: 1, duration: 0.6, ease: "back.out(1.5)", delay: 0.5 }
        );

        // ═══ NOMBRE DE LA NOVIA ═══
        animarNombre("nombre-novia", "Paola", 0.6);

        // ═══ FLORES DORADAS ═══
        gsap.fromTo(
            "#flores-doradas-izq",
            { opacity: 0, x: -100 },
            { opacity: 1, x: 0, duration: 0.8, ease: "power2.out", delay: 0.4 }
        );

        gsap.fromTo(
            "#flores-doradas-der",
            { opacity: 0, x: 100 },
            { opacity: 1, x: 0, duration: 0.8, ease: "power2.out", delay: 0.4 }
        );

        // ═══ BRILLOS LATERALES ═══
        gsap.fromTo(
            "#flores-izq",
            { opacity: 0, x: -100, scale: 0.9 },
            { opacity: 1, x: 0, scale: 1, duration: 0.8, ease: "power2.out", delay: 0.7 }
        );

        gsap.fromTo(
            "#flores-der",
            { opacity: 0, x: 100, scale: 0.9 },
            { opacity: 1, x: 0, scale: 1, duration: 0.8, ease: "power2.out", delay: 0.7 }
        );

        // ═══ SEPARADOR (misma animación que anillos) ═══
        gsap.fromTo(
            "#separador-inferior",
            { opacity: 0, scale: 0.5 },
            { opacity: 1, scale: 1, duration: 0.8, ease: "back.out(1.4)", delay: 0.8 }
        );

        // ═══ EFECTO PULSANTE EN BRILLOS ═══
        gsap.to("#flores-izq", {
            opacity: 0.8,
            scale: 1.05,
            duration: 2,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
            delay: 2
        });

        gsap.to("#flores-der", {
            opacity: 0.8,
            scale: 1.05,
            duration: 2,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
            delay: 2
        });

        console.log("✨ Animaciones de boda completadas en ~1.5 segundos!");
    });
</script>

